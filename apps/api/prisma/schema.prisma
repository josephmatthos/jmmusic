generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum TrackStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum RentalStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ProductType {
  RENTAL
  SUBSCRIPTION
}

// ============================================================
// USERS + AUTH
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  name          String
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime? @map("email_verified") @db.Timestamptz  // 🆕
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]  // 🆕
  subscriptions        Subscription[]
  orders               Order[]
  rentals              Rental[]
  playbackEvents       PlaybackEvent[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// CATÁLOGO
// ============================================================

model Artist {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  slug       String?  @unique
  bio        String?
  imageUrl   String?  @map("image_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  albums Album[]
  tracks Track[]

  @@map("artists")
}

model Album {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  coverUrl    String?   @map("cover_url")
  upc         String?
  releaseDate DateTime? @map("release_date") @db.Date
  artistId    String    @map("artist_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  artist         Artist          @relation(fields: [artistId], references: [id])
  tracks         Track[]
  rentals        Rental[]
  rentalProducts RentalProduct[]

  @@index([artistId])
  @@index([sortOrder])
  @@map("albums")
}

model Track {
  id              String      @id @default(uuid()) @db.Uuid
  albumId         String?     @map("album_id") @db.Uuid
  artistId        String      @map("artist_id") @db.Uuid
  title           String
  slug            String      @unique
  trackNumber     Int?        @map("track_number")
  isrc            String?
  upc             String?
  genre           String?
  mood            String?
  durationSeconds Int?        @map("duration_seconds")
  status          TrackStatus @default(DRAFT)
  previewKey      String?     @map("preview_key")
  streamKey       String?     @map("stream_key")
  masterKey       String?     @map("master_key")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  album          Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artist         Artist          @relation(fields: [artistId], references: [id])
  rentalProducts RentalProduct[]
  rentals        Rental[]
  playbackEvents PlaybackEvent[]

  @@index([status])
  @@index([albumId])
  @@index([artistId])
  @@index([albumId, trackNumber])
  @@map("tracks")
}

// ============================================================
// BILLING — Assinaturas
// ============================================================

model Plan {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  priceCents     Int      @map("price_cents")
  currency       String   @default("BRL") @db.Char(3)
  intervalUnit   String   @map("interval_unit")
  intervalCount  Int      @default(1) @map("interval_count")
  active         Boolean  @default(true)
  externalPlanId String?  @map("external_plan_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  externalSubscriptionId String?            @unique @map("external_subscription_id")
  status                 SubscriptionStatus @default(PENDING)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  initPoint              String?            @map("init_point")
  payerEmail             String?            @map("payer_email")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

// ============================================================
// ALUGUEL — produtos e aluguéis
// ============================================================

model RentalProduct {
  id            String   @id @default(uuid()) @db.Uuid
  trackId       String?  @map("track_id") @db.Uuid
  albumId       String?  @map("album_id") @db.Uuid
  name          String
  durationHours Int      @map("duration_hours")
  priceCents    Int      @map("price_cents")
  currency      String   @default("BRL") @db.Char(3)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")

  track Track? @relation(fields: [trackId], references: [id], onDelete: Cascade)
  album Album? @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([trackId])
  @@index([albumId])
  @@map("rental_products")
}

model Rental {
  id         String       @id @default(uuid()) @db.Uuid
  rentalCode String       @unique @map("rental_code")
  userId     String       @map("user_id") @db.Uuid
  trackId    String?      @map("track_id") @db.Uuid
  albumId    String?      @map("album_id") @db.Uuid
  orderId    String?      @map("order_id") @db.Uuid
  status     RentalStatus @default(PENDING)
  startsAt   DateTime     @map("starts_at") @db.Timestamptz
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id])
  track Track? @relation(fields: [trackId], references: [id])
  album Album? @relation(fields: [albumId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([trackId])
  @@index([albumId])
  @@map("rentals")
}

// ============================================================
// ORDERS (genérico — aluguel OU assinatura)
// ============================================================

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  status            OrderStatus @default(PENDING)
  totalCents        Int         @map("total_cents")
  currency          String      @default("BRL") @db.Char(3)
  externalPaymentId String?     @map("external_payment_id")
  idempotencyKey    String?     @unique @map("idempotency_key")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  rentals Rental[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  productType    ProductType @map("product_type")
  productId      String?     @map("product_id") @db.Uuid
  quantity       Int         @default(1)
  unitPriceCents Int         @map("unit_price_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// PLAYBACK + PAYMENT EVENTS
// ============================================================

model PlaybackEvent {
  id            BigInt   @id @default(autoincrement())
  userId        String?  @map("user_id") @db.Uuid
  trackId       String   @map("track_id") @db.Uuid
  source        String
  secondsPlayed Int      @default(0) @map("seconds_played")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User?  @relation(fields: [userId], references: [id])
  track Track  @relation(fields: [trackId], references: [id])

  @@index([trackId, createdAt])
  @@map("playback_events")
}

model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([createdAt])
  @@map("payment_events")
}

// ============================================================
// SOCIAL + NEWSLETTER
// ============================================================

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  platform  String   @unique
  label     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("social_links")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("newsletter_subscribers")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// EMAIL VERIFICATION
// ============================================================

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}